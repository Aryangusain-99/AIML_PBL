import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import matplotlib.pyplot as plt

from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

data = pd.read_csv('data.csv',encoding='ISO-8859-1')

print(data.head())
print(data.info())

print(data.isnull().sum())

print(data.describe())
kmeans.fit(data_scaled)

plt.figure(figsize=(12, 10))

corr_matrix = data.corr(numeric_only=True)

sns.heatmap(corr_matrix, cmap='coolwarm', annot=True, fmt=".2f")

plt.title("Correlation Heatmap")
plt.show()

data.hist(figsize=(15,10))
plt.show()

imputer = SimpleImputer(strategy='mean')
data_imputed = pd.DataFrame(imputer.fit_transform(data), columns=data.columns)

scaler = StandardScaler()
data_scaled = scaler.fit_transform(data_imputed)

correlation = data_imputed.corr()

target = "Crop Area (hectares)"

important_features = correlation[target][abs(correlation[target]) > 0.2].index

data_selected = data_imputed[important_features]

print("Selected Features:", list(important_features))

import warnings
warnings.filterwarnings('ignore')

wcss = []

for i in range(2, 10):
    kmeans = KMeans(n_clusters=i, random_state=42)
    kmeans.fit(data_scaled)
    wcss.append(kmeans.inertia_)

plt.plot(range(2,10), wcss, marker='o')
plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("WCSS")
plt.show()

k = 2

kmeans = KMeans(n_clusters=k, random_state=42)
clusters = kmeans.fit_predict(data_scaled)

data_imputed['Cluster'] = clusters

import matplotlib.pyplot as plt

plt.figure(figsize=(8,6))

plt.scatter(
    data_imputed['Rainfall(mm)'],
    data_imputed['Average crop Yield(tons/hec)'],
    c=data_imputed['Cluster']
)

plt.xlabel("Rainfall(mm)")
plt.ylabel("Average crop Yield (tons/hec)")
plt.title("Cluster Visualization")

plt.show()

from scipy import stats

z_scores = np.abs(stats.zscore(data_selected))
data_no_outliers = data_selected[(z_scores < 3).all(axis=1)]

data_scaled = scaler.fit_transform(data_no_outliers)

score = silhouette_score(data_scaled, clusters)
print("Silhouette Score:", score)
